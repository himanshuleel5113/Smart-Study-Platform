# Copy to .env for local Docker Compose. Never commit the real .env file.
DOCKERHUB_USER=smart-study-local
IMAGE_TAG=latest
USER_DB_PASSWORD=replace-with-local-password
STUDY_DB_PASSWORD=replace-with-local-password
QUIZ_DB_PASSWORD=replace-with-local-password
# Monitoring (Nagios Core)
NAGIOSADMIN_USER=nagiosadmin
NAGIOSADMIN_PASS=replace-with-local-password
# Generate at least 32 random bytes, then Base64 encode them.
JWT_SECRET=replace-with-base64-encoded-random-secret

# A placeholder starts the app and supports manual quizzes. AI requires a real
# Azure key, resource endpoint, and an available Responses API deployment.
AZURE_OPENAI_KEY=dummy-key-for-local-dev
OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/openai/v1/
OPENAI_MODEL=gpt-4.1-mini
